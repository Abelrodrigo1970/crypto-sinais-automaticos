// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Conjunto de símbolos (ex.: acima da MA200 vs até ±10% da MA200) para estratégias filtrarem o universo.
model SymbolUniverse {
  id               String   @id @default(cuid())
  code             String   @unique
  displayName      String
  description      String
  /// ABOVE_MA | WITHIN_PCT_OF_MA
  ruleType         String
  maPeriod         Int      @default(200)
  /// Para WITHIN_PCT_OF_MA: distância abs(close-MA)/MA * 100 <= este valor
  maxDistancePct   Float?
  timeframe        String   @default("1h")
  minQuoteVolume   Float    @default(100000)
  candidateLimit   Int      @default(400)

  strategies Strategy[]
}

/// Histórico de execuções do scanner MA200 (página /scanners/universos).
model UniverseScanRun {
  id           String   @id @default(cuid())
  universeCode String
  scannedAt    DateTime @default(now())
  rowCount     Int
  source       String

  rows UniverseScanRow[]

  @@index([universeCode, scannedAt])
}

model UniverseScanRow {
  id        String @id @default(cuid())
  runId     String
  run       UniverseScanRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  symbol    String
  close     Float
  ma        Float
  pctFromMa Float

  @@index([runId])
  @@index([symbol])
}

model Strategy {
  id          String   @id @default(cuid())
  name        String   @unique // ex: "RSI", "MA_CROSSOVER"
  displayName String   // ex: "RSI Sobrecomprado/Sobrevendido"
  description String
  isActive    Boolean  @default(true)
  params      String   @default("{}") // JSON string com parâmetros
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  symbolUniverseId String?
  symbolUniverse   SymbolUniverse? @relation(fields: [symbolUniverseId], references: [id], onDelete: SetNull)

  signals Signal[]
}

model Signal {
  id           String   @id @default(cuid())
  symbol       String   // ex: "BTCUSDT"
  direction    String   // "BUY" | "SELL"
  timeframe    String   // ex: "1m", "5m", "1h"
  strategyId   String
  strategyName String   // denormalizado para facilitar leitura
  entryPrice   Float
  stopLoss     Float
  target1      Float?
  target2      Float?
  target3      Float?
  strength     Int      // 0-100
  status       String   @default("NEW") // "NEW" | "IN_PROGRESS" | "HIT_TARGET" | "HIT_STOP" | "EXPIRED"
  generatedAt  DateTime @default(now())
  lastCheckedAt DateTime?
  extraInfo    String?  // JSON string com detalhes do cálculo
  price24h     Float?   // Preço após 24 horas
  result24h    Float?   // Resultado após 24h (diferença de preço)
  status24h    String?  // "CLOSED" quando já passaram 24h, null caso contrário
  high24h       Float?   // Preço mais alto durante as 24 horas
  low24h        Float?   // Preço mais baixo durante as 24 horas
  // executedAt e executionOrderId removidos - BD sem essas colunas (adicionar depois via migration)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@index([strategyId])
  @@index([generatedAt])
  @@index([status])
}




