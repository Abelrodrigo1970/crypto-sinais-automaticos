// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Strategy {
  id          String   @id @default(cuid())
  name        String   @unique // código da estratégia no registo (lib/strategies)
  displayName String   // ex: "RSI Sobrecomprado/Sobrevendido"
  description String
  isActive    Boolean  @default(true)
  params      String   @default("{}") // JSON string com parâmetros
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals Signal[]
}

model Signal {
  id           String   @id @default(cuid())
  symbol       String   // perpétuo Bybit, ex: "AAPLUSDT"
  direction    String   // "BUY" | "SELL"
  timeframe    String   // ex: "1m", "5m", "1h"
  strategyId   String
  strategyName String   // denormalizado para facilitar leitura
  entryPrice   Float
  stopLoss     Float?   // null quando a estratégia não usa stop
  target1      Float?
  target2      Float?
  target3      Float?
  strength     Int      // 0-100
  status       String   @default("OPEN") // "OPEN" (posição aberta) | "CLOSED" (saiu pela regra da estratégia)
  generatedAt  DateTime @default(now())
  lastCheckedAt DateTime?
  extraInfo    String?  // JSON string com detalhes do cálculo
  price24h     Float?   // Preço após 24 horas
  result24h    Float?   // Resultado após 24h (diferença de preço)
  status24h    String?  // "CLOSED" quando já passaram 24h, null caso contrário
  high24h       Float?   // Preço mais alto durante as 24 horas
  low24h        Float?   // Preço mais baixo durante as 24 horas
  /// Abertura da vela (diária) em cujo fecho se entrou
  barTime      DateTime?
  exitPrice    Float?
  exitAt       DateTime?
  /// Resultado da posição em %, já na direção do sinal (sem custos)
  resultPct    Float?
  exitReason   String?
  // executedAt e executionOrderId removidos - BD sem essas colunas (adicionar depois via migration)

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@index([strategyId])
  @@index([generatedAt])
  @@index([status])
  @@index([strategyId, symbol, status])
}
